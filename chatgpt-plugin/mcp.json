{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fattura24-official": {
      "type": "streamable-http",
      "url": "https://www.app.fattura24.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "dcr"},
            "baseScopes": ["mcp"],
            "defaultScopes": ["mcp"]
          }
        }
      }
    }
  }
}
