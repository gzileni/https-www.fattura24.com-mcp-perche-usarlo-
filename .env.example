# Copy as .env, replace the placeholder with a cryptographically random 64-char hex token.
# Launch scripts create this value automatically.
BRIDGE_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
# Demo tests call only local preview tools. Keep writes disabled.
FATTURA24_ENABLE_WRITES=false

# REQUIRES YOUR OWN FATTURA24 ACCOUNT. Store only in local .env, NEVER GitHub.
# FATTURA24_API_KEY=
# Example: after manual testing and acceptance, change to true.
